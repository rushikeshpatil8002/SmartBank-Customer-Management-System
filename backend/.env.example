# SmartBank Environment Variables Template
# Copy this file to .env and configure local credentials

DEBUG=True
SECRET_KEY=smartbank-insecure-dev-key-change-in-production-2026!@#$%^&*()
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=smartbank_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
